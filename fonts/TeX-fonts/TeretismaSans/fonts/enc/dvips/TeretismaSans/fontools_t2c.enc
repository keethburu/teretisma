/p
/q
/r
/s
/t
/u
/v
/w
% 0x78
/x
/y
/z
/braceleft
/bar
/braceright
/asciitilde
/hyphen
% 0x80
/uni04A6 % /Pemiddlehookcyrillic CYRILLIC CAPITAL LETTER PE WITH MIDDLE HOOK (giovanni)
/uni04B4 % /Tetsecyrillic CYRILLIC CAPITAL LIGATURE TE TSE (giovanni)
/uni04AC % /Tedescendercyrillic CYRILLIC CAPITAL LETTER TE WITH DESCENDER (giovanni)
/uni0494 % /Ghemiddlehookcyrillic CYRILLIC CAPITAL LETTER GHE WITH MIDDLE HOOK (giovanni)
/uni04BA % /Shhacyrillic CYRILLIC CAPITAL LETTER SHHA (giovanni)
/CYRRDSC        % CYRILLIC CAPITAL LETTER ER WITH DESCENDER
/uni048E %      % CYRILLIC CAPITAL LETTER ER WITH STROKE / TICK (giovanni)
/uni04E0 % /Dzeabkhasiancyrillic CYRILLIC CAPITAL LETTER ABKHASIAN DZE (giovanni)
% 0x88
/uni04CD % from /CYRMDSC        CYRILLIC CAPITAL LETTER EM WITH DESCENDER (giovanni)
/uni049A % /Kadescendercyrillic CYRILLIC CAPITAL LETTER KA WITH DESCENDER (giovanni)
/uni04C5 % from /CYRLDSC        CYRILLIC CAPITAL LETTER EL WITH DESCENDER (giovanni)
/uni049E % /Kastrokecyrillic CYRILLIC CAPITAL LETTER KA WITH STROKE (giovanni)
/uni04C5 % CYRILLIC CAPITAL LETTER EL WITH TAIL , from /CYRLDSC       CYRILLIC CAPITAL LETTER EL WITH DESCENDER (giovanni)
/uni04A2 % /Endescendercyrillic CYRILLIC CAPITAL LETTER EN WITH DESCENDER (giovanni)
/uni04CD % CYRILLIC CAPITAL LETTER EM WITH TAIL, from /CYRMHK         CYRILLIC CAPITAL LETTER EM WITH HOOK (giovanni)
/uni04C7 % /Enhookcyrillic CYRILLIC CAPITAL LETTER EN WITH HOOK (giovanni)
% 0x90
/uni04E8 % /Obarredcyrillic CYRILLIC CAPITAL LETTER BARRED O (giovanni)
/uni04BC % /Cheabkhasiancyrillic CYRILLIC CAPITAL LETTER ABKHASIAN CHE (giovanni)
/uni04BE % /Chedescenderabkhasiancyrillic CYRILLIC CAPITAL LETTER ABKHASIAN CHE WITH DESCENDER (giovanni)
/uni048C        % U+048C;CYRILLIC CAPITAL LETTER SEMISOFT SIGN (giovanni)
/uni048A % from /CYRISHRTDSC    CYRILLIC CAPITAL LETTER SHORT I WITH DESCENDER / TAIL (giovanni)
/uni04B2 % /Hadescendercyrillic CYRILLIC CAPITAL LETTER HA WITH DESCENDER (giovanni)
/afii10145
/uni04A8 % /Haabkhasiancyrillic CYRILLIC CAPITAL LETTER ABKHASIAN HA (giovanni)
% 0x98
/uni04B6 % /Chedescendercyrillic CYRILLIC CAPITAL LETTER CHE WITH DESCENDER (giovanni)
/CYRNLHK        % CYRILLIC CAPITAL LETTER EN WITH LEFT HOOK
/uni04D8 % /Schwacyrillic CYRILLIC CAPITAL LETTER SCHWA (giovanni)
/CYRRHK         % CYRILLIC CAPITAL LETTER ER WITH HOOK
/afii10023
/afii61352
/currency
/section
% 0xA0
/uni04A7 % /pemiddlehookcyrillic CYRILLIC SMALL LETTER PE WITH MIDDLE HOOK (giovanni)
/uni04B5 % /tetsecyrillic CYRILLIC SMALL LIGATURE TE TSE (giovanni)
/uni04AD % /tedescendercyrillic CYRILLIC SMALL LETTER TE WITH DESCENDER (giovanni)
/uni0495 % /ghemiddlehookcyrillic CYRILLIC SMALL LETTER GHE WITH MIDDLE HOOK (giovanni)
/uni04BB % /shhacyrillic CYRILLIC SMALL LETTER SHHA (giovanni)
/cyrrdsc        % CYRILLIC SMALL LETTER ER WITH DESCENDER
/uni048F % CYRILLIC SMALL LETTER ER WITH STROKE
/uni04E1 % /dzeabkhasiancyrillic CYRILLIC SMALL LETTER ABKHASIAN DZE (giovanni)
% 0xA8
/uni04CE % from /cyrmdsc        CYRILLIC SMALL LETTER EM WITH DESCENDER (giovanni)
/uni049B % /kadescendercyrillic CYRILLIC SMALL LETTER KA WITH DESCENDER (giovanni)
/uni04C6 % from /cyrldsc        CYRILLIC SMALL LETTER EL WITH DESCENDER  (giovanni)
/uni049F % /kastrokecyrillic CYRILLIC SMALL LETTER KA WITH STROKE (giovanni)
/uni04C6 % from /cyrlhk         CYRILLIC SMALL LETTER EL WITH HOOK (giovanni)
/uni04A3 % /endescendercyrillic CYRILLIC SMALL LETTER EN WITH DESCENDER (giovanni)
/uni04CE % from /cyrmhk         CYRILLIC SMALL LETTER EM WITH HOOK (giovanni)
/uni04C8 % /enhookcyrillic CYRILLIC SMALL LETTER EN WITH HOOK (giovanni)
% 0xB0
/uni04E9 % /obarredcyrillic CYRILLIC SMALL LETTER BARRED O (giovanni)
/uni04BD % /cheabkhasiancyrillic CYRILLIC SMALL LETTER ABKHASIAN CHE (giovanni)
/uni04BF % /chedescenderabkhasiancyrillic CYRILLIC SMALL LETTER ABKHASIAN CHE WITH DESCENDER (giovanni)
/uni048D        % CYRILLIC SMALL LETTER SEMISOFT SIGN (giovanni)
/uni048B % from /cyrishrtdsc    CYRILLIC SMALL LETTER SHORT I WITH DESCENDER (giovanni)
/uni04B3 % /hadescendercyrillic CYRILLIC SMALL LETTER HA WITH DESCENDER (giovanni)
/afii10193
