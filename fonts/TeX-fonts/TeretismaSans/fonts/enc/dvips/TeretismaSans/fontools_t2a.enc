% A version of the T2A encoding, intended for use with otftotfm.
% CODINGSCHEME TEX CYRILLIC FONT ENCODING - T2A
/otftotfmT2AEncoding [
% 0x00
/grave
/acute
/circumflex
/tilde
/dieresis
/hungarumlaut
/ring
/caron
% 0x08
/breve
/macron
/dotaccent
/cedilla
/ogonek
/uni04C0 %/palochkacyrillic CYRILLIC LETTER PALOCHKA (giovanni)
/angleleft
/angleright
