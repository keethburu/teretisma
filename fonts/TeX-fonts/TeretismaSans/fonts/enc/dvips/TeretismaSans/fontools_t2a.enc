/quotedblleft
/quotedblright
/cyrflex
/dblgrave
/cyrbreve
/endash
/emdash
/.notdef
% 0x18
/perthousandzero
/dotlessi
/dotlessj
/ff
/fi
/fl
/ffi
/ffl
