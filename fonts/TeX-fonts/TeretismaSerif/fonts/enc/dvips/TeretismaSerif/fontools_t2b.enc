/uni04FA % from /CYRGDSCHCRS    % CYRILLIC CAPITAL LETTER GHE WITH STROKE AND DESCENDER (giovanni)
/uni0492 % /Ghestrokecyrillic CYRILLIC CAPITAL LETTER GHE WITH STROKE (giovanni)
/uni04F6 % from /CYRGDSC        % CYRILLIC CAPITAL LETTER GHE WITH DESCENDER (giovanni)
/uni0494 % /Ghemiddlehookcyrillic CYRILLIC CAPITAL LETTER GHE WITH MIDDLE HOOK (giovanni)
/uni04BA % /Shhacyrillic CYRILLIC CAPITAL LETTER SHHA (giovanni)
/uni0496 % /Zhedescendercyrillic CYRILLIC CAPITAL LETTER ZHE WITH DESCENDER (giovanni)
/CYRDELTA       % CYRILLIC CAPITAL LETTER DELTA
/uni04E0 %  /Dzeabkhasiancyrillic CYRILLIC CAPITAL LETTER ABKHASIAN DZE (giovanni)
% 0x88
/afii10058
/uni049A % /Kadescendercyrillic CYRILLIC CAPITAL LETTER KA WITH DESCENDER (giovanni)
/uni04C5 % CYRILLIC CAPITAL LETTER EL WITH TAIL , from /CYRLDSC       CYRILLIC CAPITAL LETTER EL WITH DESCENDER (giovanni)
/uni04C3 % /Kahookcyrillic CYRILLIC CAPITAL LETTER KA WITH HOOK (giovanni)
/uni04C5 % CYRILLIC CAPITAL LETTER EL WITH TAIL /CYRLDSC , from /CYRLHK         CYRILLIC CAPITAL LETTER EL WITH HOOK (giovanni)
/uni04A2 % /Endescendercyrillic CYRILLIC CAPITAL LETTER EN WITH DESCENDER (giovanni)
/uni04A4 % /Enghecyrillic CYRILLIC CAPITAL LIGATURE EN GHE (giovanni)
/uni04C7 % /Enhookcyrillic CYRILLIC CAPITAL LETTER EN WITH HOOK (giovanni)
% 0x90
/uni04E8 % /Obarredcyrillic CYRILLIC CAPITAL LETTER BARRED O (giovanni)
/CYRSACRS       % CYRILLIC CAPITAL LETTER ES WITH STROKE
/afii10062
/uni04AE % /Ustraightcyrillic CYRILLIC CAPITAL LETTER STRAIGHT U (giovanni)
/uni04FE % from /CYRHHCRS       CYRILLIC CAPITAL LETTER HA WITH STROKE (giovanni)
/uni04B2 % /Hadescendercyrillic CYRILLIC CAPITAL LETTER HA WITH DESCENDER (giovanni)
/uni04FC % from /CYRHHK         CYRILLIC CAPITAL LETTER HA WITH HOOK (giovanni)
/uni04CB % /Chekhakassiancyrillic CYRILLIC CAPITAL LETTER KHAKASSIAN CHE (giovanni)
% 0x98
/uni04B6 % /Chedescendercyrillic CYRILLIC CAPITAL LETTER CHE WITH DESCENDER (giovanni)
/afii10059
/uni04D8 % /Schwacyrillic CYRILLIC CAPITAL LETTER SCHWA (giovanni)
/CYREPS         % CYRILLIC CAPITAL LETTER EPSILON
/afii10023
/afii61352
/currency
/section
