% UNICODING sixoldstyle =: sixoldstyle uniF236 ;
% UNICODING sevenoldstyle =: sevenoldstyle uniF237 ;
% UNICODING eightoldstyle =: eightoldstyle uniF238 ;
% UNICODING nineoldstyle =: nineoldstyle uniF239 ;
% UNICODING capitalgrave =: gravecomb.case ;
% UNICODING capitalacute =: acutecomb.case ;
% UNICODING capitalcircumflex =: uni0302.case ;
% UNICODING capitaltilde =: tildecomb.case ;
% UNICODING capitaldieresis =: uni0308.case ;
% UNICODING capitalhungarumlaut =: uni030B.case ;
% UNICODING capitalring =: uni030A.case ;
% UNICODING capitalcaron =: uni030C.case ;
% UNICODING capitalbreve =: uni0306.case ;
% UNICODING capitalmacron =: uni0304.case ;
% UNICODING capitaldotaccent =: uni0307.case ;
% UNICODING ascendercompwordmark =: uni200C ;
