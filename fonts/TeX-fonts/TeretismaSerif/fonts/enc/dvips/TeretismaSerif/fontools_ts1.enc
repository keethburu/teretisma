%
% additions to $TEXMFDIST/fonts/map/glyphlist/ (giovanni, 2021-01-07)
% UNICODING naira =: naira uni20A6 ;
% UNICODING peso =: peso uni20B1 ;
% UNICODING guarani =: guarani uni20B2 ;
% UNICODING recipe =: recipe uni211E ;
% UNICODING pilcrow =: pilcrow uni00B6 ;
% UNICODING baht =: baht uni0E3F ;
  %only bahtthai;0E3F exists in $TEXMFDIST/fonts/map/glyphlist/ , but U+0E3F is not in Teretisma Fonts
% UNICODING servicemark =: servicemark uni2120 ;
%
% UNICODING bardbl =: bardbl dblverticalbar ;
  %this allows for bardbl (U*2225) the fallback dblverticalbar (U+2016) (giovanni, 2021-01-07)
% UNICODING tildelow =: tildelow uni223C asciitilde ;
  %this allows to use fallbacks (giovanni, 2021-01-07)
% UNICODING blank =: uni2422 blank ;
  %if uni2422 exists, this prevents otftotfm from using U+2423 (OPEN BOX) (giovanni, 2021-01-07)
% UNICODING tieaccentlowercase =: tieaccentlowercase uni0361 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING tieaccentcapital =: tieaccentcapital uni0361 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING newtieaccentlowercase =: newtieaccentlowercase uni2040 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING newtieaccentcapital =: newtieaccentcapital uni2040 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING hyphendbl =: hyphendbl uni2E17 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING hyphendblchar =: hyphendblchar uni2E17 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING bigcircle =: bigcircle circle ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING openbracketleft =: openbracketleft uni27E6 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING openbracketright =: openbracketright uni27E7 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING centoldstyle =: centoldstyle cent ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING dollaroldstyle =: dollaroldstyle dollar ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING openbullet =: openbullet uni2E30 ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING born =: born asterisk ;
  %this allows to use a fallback (giovanni, 2021-01-07)
% UNICODING died =: died dagger ;
  %this allows to use a fallback (giovanni, 2021-01-07)

% UNICODING zerooldstyle =: zerooldstyle uniF230 ;
% UNICODING oneoldstyle =: oneoldstyle uniF231 ;
% UNICODING twooldstyle =: twooldstyle uniF232 ;
% UNICODING threeoldstyle =: threeoldstyle uniF233 ;
% UNICODING fouroldstyle =: fouroldstyle uniF234 ;
